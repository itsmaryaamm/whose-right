# Your Gemini API key from https://aistudio.google.com/apikey (the free tier works)
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite   # comma-separated fallback chain
# ANTHROPIC_API_KEY=   # use Claude instead (only if GEMINI_API_KEY is not set)
# DATABASE_URL=postgres://...   # free Neon database; without it, cases go in ./data
# PORT=8787
# DATA_DIR=./data
# MOCK_AI=1            # canned replies, no AI key needed
